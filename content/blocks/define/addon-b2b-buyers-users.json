    "beginner": [
      "List the buyer, the users and any administrators.",
      "Write what each one needs to succeed.",
      "Spot conflicts, such as control versus ease of use.",
      "Decide how to meet both.",
      "Measure success for each group."
    ],
    "intermediate": [
      "Define needs for buyers, users and admins.",
      "Resolve conflicts.",
      "Set measures for each."
    ],
