      "Show staff how the tool helps them, not just the organisation.",
      "Train people close to when they will use it.",
      "Find champions in each team.",
      "Track usage by team and help those who are stuck.",
      "Retire the old tool when ready."
    ],
    "intermediate": [
      "Plan communication, training and champions.",
      "Track adoption by team.",
      "Retire old tools."
    ],
    "experienced": [
      "Get managers to support adoption.",
      "Link adoption to business outcomes.",
      "Use feedback to improve the tool quickly."
    ]
  },
