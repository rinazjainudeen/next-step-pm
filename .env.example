# Copy this file to .env.local and fill in values. Never commit .env.local.
# In Vercel, add the same names under Project > Settings > Environment Variables.

# The public address of the site. Not a secret.
# Local development: http://localhost:3000
# Vercel: set to your live address, e.g. https://next-step-pm.vercel.app
NEXT_PUBLIC_SITE_URL=

# --- Feedback (Phase 9a). All server-only: never add NEXT_PUBLIC_ to these. ---

# Supabase project address, from Project Settings > API (Data API). Use the DEV project locally.
SUPABASE_URL=
# Supabase secret key (starts sb_secret_), from Project Settings > API Keys. It bypasses
# Row Level Security, so it must only ever be used on the server.
SUPABASE_SECRET_KEY=

# Resend API key, from resend.com > API Keys. Sends the alert email when feedback arrives.
RESEND_API_KEY=
# The address that receives the alert emails. Your own address. Never write it in the code.
FEEDBACK_ALERT_EMAIL=

# Optional, for `pnpm check:supabase` only. The site never uses it. Supabase's publishable key
# (starts sb_publishable_) is public by design: the check uses it to prove a browser can't read the tables.
SUPABASE_PUBLISHABLE_KEY=
